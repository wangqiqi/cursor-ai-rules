{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/code-quality.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/security-audit.sh"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/command-log.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/prompt-security.sh"
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/rule-usage-tracker.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/session-summary.sh"
      }
    ]
  }
}