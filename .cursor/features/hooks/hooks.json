{
  "version": 3,
  "description": "Cursor AI Rules 完整钩子配置文件 - 实现全面自动化",
  "hooks": {
    "onSessionStart": [
      {
        "name": "role-activation",
        "description": "会话开始角色系统初始化",
        "command": "features/hooks/role-activation.sh",
        "timeout": 8000,
        "async": true,
        "enabled": true,
        "priority": 95,
        "run_if_context": {
          "event": "onSessionStart"
        }
      },
      {
        "name": "master-init",
        "description": "Master命令初始化",
        "command": "features/hooks/master-init.sh",
        "timeout": 7000,
        "async": true,
        "enabled": true,
        "priority": 90,
        "run_if_context": {
          "event": "onSessionStart"
        }
      },
      {
        "name": "env-perception",
        "description": "会话开始环境感知",
        "command": "features/hooks/env-perception.sh",
        "timeout": 5000,
        "async": true,
        "enabled": true
      },
      {
        "name": "session-optimizer",
        "description": "会话开始系统优化",
        "command": "features/hooks/session-optimizer.sh",
        "timeout": 6000,
        "async": true,
        "enabled": true
      },
      {
        "name": "growth-directory-check",
        "description": "会话开始时检查生长目录",
        "command": "features/automation/automation/scripts/growth_init.sh",
        "timeout": 5000,
        "async": true,
        "enabled": true
      },
      {
        "name": "session-state-guard",
        "description": "本地状态守护",
        "command": "features/hooks/session-state-guard.sh",
        "args": ["onSessionStart"],
        "timeout": 2000,
        "async": false,
        "enabled": true,
        "priority": 80,
        "run_if_context": {
          "event": "onSessionStart"
        }
      }
    ],
    "afterFileSave": [
      {
        "name": "consistency-check",
        "description": "代码一致性自动检查",
        "command": "features/hooks/consistency-check.sh",
        "timeout": 10000,
        "async": true,
        "enabled": true
      },
      {
        "name": "architecture-check",
        "description": "架构合规性检查",
        "command": "features/hooks/architecture-check.sh",
        "timeout": 8000,
        "async": true,
        "enabled": true
      },
      {
        "name": "code-quality",
        "description": "代码质量检查",
        "command": "features/hooks/code-quality.sh",
        "timeout": 5000,
        "async": true,
        "enabled": true
      },
      {
        "name": "quality-check",
        "description": "统一质量管理系统检查",
        "command": "features/hooks/quality-check.sh",
        "timeout": 15000,
        "async": true,
        "enabled": true
      },
      {
        "name": "config-validator",
        "description": "配置文件自动验证",
        "command": "core/config-manager.sh",
        "args": ["validate_enhanced"],
        "timeout": 5000,
        "async": true,
        "enabled": true
      },
      {
        "name": "dependency-check",
        "description": "依赖关系自动检查",
        "command": "features/hooks/dependency-check.sh",
        "timeout": 8000,
        "async": true,
        "enabled": true
      }
    ],
    "afterShellExecution": [
      {
        "name": "performance-monitor",
        "description": "命令执行性能监控",
        "command": "features/hooks/performance-monitor.sh",
        "timeout": 3000,
        "async": true,
        "enabled": true
      },
      {
        "name": "command-log",
        "description": "命令执行日志记录",
        "command": "features/hooks/logging-common.sh",
        "args": ["command"],
        "timeout": 3000,
        "async": true,
        "enabled": true,
        "priority": 50
      },
      {
        "name": "event-logger",
        "description": "通用事件日志记录",
        "command": "features/hooks/logging-common.sh",
        "args": ["event"],
        "timeout": 2000,
        "async": true,
        "enabled": true,
        "priority": 40
      }
    ],
    "afterAgentResponse": [
      {
        "name": "growth-recorder",
        "description": "AI响应后生长记录",
        "command": "features/hooks/growth-recorder.sh",
        "timeout": 3000,
        "async": true,
        "enabled": true
      },
      {
        "name": "token-compression",
        "description": "AI响应后Token压缩优化",
        "command": "features/hooks/token-compression.sh",
        "timeout": 5000,
        "async": true,
        "enabled": true
      },
      {
        "name": "agent-orchestration",
        "description": "8个智能代理协作编排",
        "command": "core/agent-orchestration-engine.sh",
        "timeout": 15000,
        "async": true,
        "enabled": true,
        "priority": 70,
        "run_if_context": {
          "load": "moderate"
        }
      },
      {
        "name": "context-pool-manager",
        "description": "上下文池动态管理",
        "command": "core/context-pool-manager.sh",
        "timeout": 8000,
        "async": true,
        "enabled": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "name": "session-state-guard",
        "description": "会话状态守护",
        "command": "features/hooks/session-state-guard.sh",
        "args": ["beforeSubmitPrompt"],
        "timeout": 4000,
        "async": false,
        "enabled": true,
        "priority": 100,
        "run_if_context": {
          "event": "beforeSubmitPrompt"
        }
      },
      {
        "name": "role-sync",
        "description": "强制角色同步 - 确保每个对话框都有正确的角色状态",
        "command": "features/hooks/role-sync.sh",
        "timeout": 5000,
        "async": false,
        "enabled": true
      },
      {
        "name": "context-management",
        "description": "智能上下文管理",
        "command": "core/context-manager.sh",
        "timeout": 5000,
        "async": false,
        "enabled": true
      },
      {
        "name": "prompt-security",
        "description": "提示安全检查",
        "command": "features/hooks/prompt-security.sh",
        "timeout": 2000,
        "async": false,
        "enabled": true
      },
      {
        "name": "master-sync-trigger",
        "description": "检测对话框首次使用/master命令并触发同步",
        "command": "features/hooks/master-sync-trigger.sh",
        "timeout": 10000,
        "async": true,
        "enabled": true
      }
    ],
    "preCommitAnalysis": [
      {
        "name": "pre-commit-analyzer",
        "description": "预提交深度分析",
        "command": "features/hooks/pre-commit-analyzer.sh",
        "timeout": 15000,
        "async": true,
        "enabled": true
      }
    ],
    "commitMessageValidation": [
      {
        "name": "commit-message-validator",
        "description": "提交消息格式验证",
        "command": "features/hooks/commit-message-validator.sh",
        "timeout": 5000,
        "async": false,
        "enabled": true
      }
    ],
    "preCommitOptimization": [
      {
        "name": "adaptive-optimization",
        "description": "自适应优化和A/B测试",
        "command": "core/adaptive-optimization-engine.sh",
        "timeout": 12000,
        "async": true,
        "enabled": true
      },
      {
        "name": "experiment-framework",
        "description": "实验框架自动化",
        "command": "core/experiment-framework.sh",
        "timeout": 15000,
        "async": true,
        "enabled": true
      }
    ],
    "postCommitLogging": [
      {
        "name": "post-commit-logger",
        "description": "后提交日志记录和分析",
        "command": "features/hooks/post-commit-logger.sh",
        "timeout": 10000,
        "async": true,
        "enabled": true
      }
    ],
    "onConversationStart": [
      {
        "name": "conversation-init",
        "description": "新对话框初始化和角色激活",
        "command": "features/hooks/conversation-init.sh",
        "timeout": 3000,
        "async": true,
        "enabled": true
      },
      {
        "name": "session-state-guard",
        "description": "确保多对话状态保持",
        "command": "features/hooks/session-state-guard.sh",
        "args": ["onConversationStart"],
        "timeout": 2500,
        "async": true,
        "enabled": true,
        "priority": 60,
        "run_if_context": {
          "event": "onConversationStart"
        }
      },
      {
        "name": "master-sync-init",
        "description": "新对话框开始时初始化Master同步状态",
        "command": "features/hooks/master-sync-init.sh",
        "timeout": 2000,
        "async": true,
        "enabled": true
      }
    ],
    "onSessionEnd": [
      {
        "name": "cursor-sync",
        "description": "会话结束时同步Cursor对话记录",
        "command": "features/hooks/cursor-sync.sh",
        "timeout": 10000,
        "async": true,
        "enabled": true
      },
      {
        "name": "session-learning",
        "description": "会话结束学习总结",
        "command": "core/continuous-learning-loop.sh",
        "args": ["session_summary"],
        "timeout": 15000,
        "async": true,
        "enabled": true
      },
      {
        "name": "continuous-learning",
        "description": "持续学习循环",
        "command": "core/continuous-learning-loop.sh",
        "timeout": 20000,
        "async": true,
        "enabled": true
      }
    ],
    "onEnvironmentChange": [
      {
        "name": "mcp-integration",
        "description": "本地工具MCP集成",
        "command": "core/local-mcp-integration.sh",
        "timeout": 20000,
        "async": true,
        "enabled": true
      }
    ],
    "performanceReportGeneration": [
      {
        "name": "performance-dashboard",
        "description": "性能仪表板报告",
        "command": "core/performance-dashboard.sh",
        "timeout": 15000,
        "async": true,
        "enabled": true
      }
    ],
    "onDebugSessionStart": [
      {
        "name": "pattern-analyzer",
        "description": "错误模式智能分析",
        "command": "core/pattern-analyzer.sh",
        "timeout": 20000,
        "async": true,
        "enabled": true
      }
    ],
    "onErrorDetected": [
      {
        "name": "isolation-debugger",
        "description": "隔离调试环境",
        "command": "core/isolation-debugger.sh",
        "timeout": 15000,
        "async": true,
        "enabled": true
      }
    ],
    "tokenOptimization": [
      {
        "name": "token-compression",
        "description": "Token智能压缩",
        "command": "core/token-compression.sh",
        "timeout": 10000,
        "async": true,
        "enabled": true
      }
    ],
    "qualityReportGeneration": [
      {
        "name": "quality-reporter",
        "description": "质量报告生成",
        "command": "core/quality-manager.sh",
        "args": ["generate_report"],
        "timeout": 12000,
        "async": true,
        "enabled": true
      }
    ],
    "onComplexConversation": [
      {
        "name": "conversational-system",
        "description": "高级会话命令处理",
        "command": "core/conversational-command-system.sh",
        "timeout": 13000,
        "async": true,
        "enabled": true,
        "priority": 55,
        "run_if_context": {
          "conversation_type": "complex"
        }
      }
    ]
  },
  "global_config": {
    "max_execution_time": 30000,
    "error_handling": "log_and_continue",
    "logging_enabled": true,
    "telemetry_enabled": false
  }
}