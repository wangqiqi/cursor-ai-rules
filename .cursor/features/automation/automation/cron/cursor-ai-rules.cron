# Cursor AI Rules - 自动化任务配置
# 安装方法: crontab .cursor/features/automation/automation/cron/cursor-ai-rules.cron
# 或添加到系统crontab: sudo crontab -u username .cursor/features/automation/automation/cron/cursor-ai-rules.cron

# 项目路径配置
PROJECT_PATH=/path/to/your/project
CURSOR_DIR=$PROJECT_PATH/.cursor

# ============================================================================
# 🤖 核心AI自动化任务
# ============================================================================

# 持续学习循环 - 每小时执行
0 * * * * $CURSOR_DIR/core/continuous-learning-loop.sh --incremental >> $PROJECT_PATH/.cursorGrowth/logs/cron-continuous-learning.log 2>&1

# 深度学习优化 - 每天凌晨2点执行
0 2 * * * $CURSOR_DIR/core/self-learning-engine.sh --deep-analysis >> $PROJECT_PATH/.cursorGrowth/logs/cron-deep-learning.log 2>&1

# 自适应优化引擎 - 每周日凌晨3点执行
0 3 * * 0 $CURSOR_DIR/core/adaptive-optimization-engine.sh --full-optimization >> $PROJECT_PATH/.cursorGrowth/logs/cron-adaptive-opt.log 2>&1

# ============================================================================
# 🔧 维护与优化任务
# ============================================================================

# Token压缩优化 - 每4小时执行
0 */4 * * * $CURSOR_DIR/core/token-compression.sh --optimize >> $PROJECT_PATH/.cursorGrowth/logs/cron-token-compress.log 2>&1

# 质量报告生成 - 每天早上8点执行
0 8 * * * $CURSOR_DIR/core/quality-reporter.sh --generate >> $PROJECT_PATH/.cursorGrowth/logs/cron-quality-report.log 2>&1

# MCP工具更新检查 - 每天早上9点执行
0 9 * * * $CURSOR_DIR/core/local-mcp-integration.sh --update-tools >> $PROJECT_PATH/.cursorGrowth/logs/cron-mcp-update.log 2>&1

# ============================================================================
# 📊 监控与报告任务
# ============================================================================

# 性能监控检查 - 每30分钟执行
*/30 * * * * $CURSOR_DIR/core/performance-monitor.sh check >> $PROJECT_PATH/.cursorGrowth/logs/cron-performance.log 2>&1

# 上下文管理清理 - 每天晚上10点执行
0 22 * * * $CURSOR_DIR/core/context-manager.sh --cleanup >> $PROJECT_PATH/.cursorGrowth/logs/cron-context-cleanup.log 2>&1

# ============================================================================
# 🔍 诊断与维护任务
# ============================================================================

# 模式分析更新 - 每周一早上6点执行
0 6 * * 1 $CURSOR_DIR/core/pattern-analyzer.sh --update-patterns >> $PROJECT_PATH/.cursorGrowth/logs/cron-pattern-update.log 2>&1

# 实验框架状态检查 - 每天中午12点执行
0 12 * * * $CURSOR_DIR/core/experiment-framework.sh --check-status >> $PROJECT_PATH/.cursorGrowth/logs/cron-experiment-check.log 2>&1

# ============================================================================
# 📈 生长系统任务
# ============================================================================

# 生长数据分析 - 每周六早上7点执行
0 7 * * 6 $CURSOR_DIR/core/growth-manager.sh analyze >> $PROJECT_PATH/.cursorGrowth/logs/cron-growth-analysis.log 2>&1

# AI代理健康检查 - 每2小时执行
0 */2 * * * $CURSOR_DIR/core/agent-orchestration-engine.sh --health-check >> $PROJECT_PATH/.cursorGrowth/logs/cron-agent-health.log 2>&1

# ============================================================================
# 🔄 备份与安全任务
# ============================================================================

# 生长数据备份 - 每周日凌晨1点执行
0 1 * * 0 $PROJECT_PATH/.cursor/core/growth-manager.sh backup >> $PROJECT_PATH/.cursorGrowth/logs/cron-backup.log 2>&1

# 系统使用监控 - 每天早上6点执行
0 6 * * * $CURSOR_DIR/core/usage-monitor.sh --generate-only >> $PROJECT_PATH/.cursorGrowth/logs/cron-usage-monitor.log 2>&1

# 日志轮转清理 - 每月1号凌晨4点执行
0 4 1 * * find $PROJECT_PATH/.cursorGrowth/logs -name "*.log" -mtime +30 -delete >> $PROJECT_PATH/.cursorGrowth/logs/cron-log-rotate.log 2>&1

# ============================================================================
# ⚠️ 重要说明
# ============================================================================
#
# 1. 安装前请修改 PROJECT_PATH 为实际项目路径
# 2. 确保所有脚本都有执行权限: chmod +x .cursor/core/*.sh
# 3. 首次运行前先手动测试各个脚本
# 4. 日志文件会自动创建在 .cursorGrowth/logs/ 目录
# 5. 可以根据系统负载调整执行频率
# 6. 重要任务失败时会记录到日志中
#
# 安装命令:
# crontab .cursor/features/automation/automation/cron/cursor-ai-rules.cron
#
# 查看运行状态:
# crontab -l
#
# 停止所有任务:
# crontab -r
#
# ============================================================================