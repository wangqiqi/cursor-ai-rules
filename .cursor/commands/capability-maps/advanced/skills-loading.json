    },
    "ai_integration": {
      "skills": ["mcp-builder", "skill-creator", "node_mcp_server", "python_mcp_server", "mcp_specification"],
      "enabled": true,
      "priority": 9,
      "dependencies": ["network", "file_system"],
      "capabilities": ["ai_services", "mcp_integration"]
    },
    "enterprise_collaboration": {
      "skills": ["brand-guidelines", "internal-comms", "doc-coauthoring"],
      "enabled": true,
      "priority": 7,
      "dependencies": ["network", "authentication"],
      "capabilities": ["team_collaboration", "content_management"]
    },
    "testing_development": {
      "skills": ["webapp-testing", "web-artifacts-builder", "evaluation"],
      "enabled": true,
      "priority": 8,
      "dependencies": ["browser", "file_system"],
      "capabilities": ["testing", "quality_assurance"]
    },
    "vibe_development": {
      "skills": ["context-manager", "code-generator", "dependency-tracker", "test-validator", "doc-generator", "deployment-manager"],
      "enabled": true,
      "priority": 10,
      "dependencies": ["file_system", "git"],
      "capabilities": ["development_workflow", "automation"]
    }
  },
  "loading_configuration": {
    "lazy_loading": {
      "enabled": true,
      "preload_core_skills": true,
      "core_skills": ["docx", "pdf", "webapp-testing", "context-manager"]
    },
    "skill_discovery": {
      "auto_discovery": true,
      "discovery_paths": [
        ".cursor/features/skills/",
        ".cursor/core/skills/"
      ],
      "file_extensions": [".js", ".ts", ".json"],
      "validation_required": true
    },
    "dependency_resolution": {
      "enabled": true,
      "circular_dependency_detection": true,
      "missing_dependency_handling": "warn_and_skip"
    }
  },
  "skill_execution": {
    "isolation_mode": "sandbox",
    "timeout_settings": {
      "default_timeout": 30000,
      "max_timeout": 120000,
      "per_skill_timeouts": {
        "docx": 10000,
        "pdf": 15000,
        "webapp-testing": 60000
      }
    },
    "resource_limits": {
      "max_memory_mb": 512,
      "max_cpu_percent": 50,
      "network_access": "restricted"
    },
    "error_handling": {
      "skill_failure_policy": "isolate_and_continue",
      "max_skill_failures": 3,
      "failure_reporting": true
    }
  },
  "skill_monitoring": {
    "performance_tracking": {
      "enabled": true,
      "metrics": ["execution_time", "memory_usage", "success_rate"],
      "retention_period_days": 30
    },
    "usage_analytics": {
      "enabled": true,
      "track_popular_skills": true,
      "error_pattern_analysis": true
    },
    "health_checks": {
      "enabled": true,
      "check_interval_seconds": 300,
      "auto_restart_failed_skills": true
    }
  }
}