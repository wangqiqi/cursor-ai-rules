{
  "strategies": {
    "graceful_degradation": {
      "enabled": true,
      "degradation_levels": [
        "skip_optional_features",
        "reduce_parallelism",
        "fallback_to_basic_mode",
        "minimal_functionality"
      ]
    },
    "retry_mechanism": {
      "max_attempts": 3,
      "backoff_multiplier": 1.5,
      "retryable_errors": [
        "network_timeout",
        "service_unavailable",
        "temporary_failure"
      ],
      "enabled": true,
      "fallback_mappings": {
        "network_error": ["local_fallback"],
        "service_error": ["cached_response"]
      }
    },
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 5,
      "recovery_timeout": 60,
      "monitoring_window": 300
    }
  },
  "recovery_actions": {
    "auto_restart": {
      "enabled": true,
      "max_restarts": 3,
      "restart_delay": 5000
    },
    "rollback_deployment": {
      "enabled": true,
      "backup_retention_days": 7,
      "auto_rollback_on_failure": false
    },
    "notification_system": {
      "enabled": true,
      "channels": ["console", "log"],
      "severity_levels": ["error", "warning", "info"]
    }
  }
}