{
  "pre_execution_hooks": [
    {
      "name": "environment_validation",
      "script": "core/hooks/pre-exec-env-check.sh",
      "enabled": true,
      "priority": 100,
      "timeout": 5000,
      "failure_policy": "abort"
    },
    {
      "name": "dependency_check",
      "script": "core/hooks/pre-exec-dependency-check.sh",
      "enabled": true,
      "priority": 90,
      "timeout": 10000,
      "failure_policy": "warn"
    },
    {
      "name": "permission_validation",
      "script": "core/hooks/pre-exec-permission-check.sh",
      "enabled": true,
      "priority": 80,
      "timeout": 3000,
      "failure_policy": "abort"
    }
  ],
  "post_execution_hooks": [
    {
      "name": "cleanup_temp_files",
      "script": "core/hooks/post-exec-cleanup.sh",
      "enabled": true,
      "priority": 100,
      "timeout": 5000,
      "failure_policy": "warn"
    },
    {
      "name": "log_aggregation",
      "script": "core/hooks/post-exec-log-aggregate.sh",
      "enabled": true,
      "priority": 90,
      "timeout": 3000,
      "failure_policy": "continue"
    },
    {
      "name": "metrics_collection",
      "script": "core/hooks/post-exec-metrics.sh",
      "enabled": true,
      "priority": 80,
      "timeout": 2000,
      "failure_policy": "continue"
    }
  ],
  "error_hooks": [
    {
      "name": "error_reporting",
      "script": "core/hooks/on-error-report.sh",
      "enabled": true,
      "priority": 100,
      "timeout": 5000,
      "failure_policy": "continue"
    },
    {
      "name": "rollback_trigger",
      "script": "core/hooks/on-error-rollback.sh",
      "enabled": true,
      "priority": 90,
      "timeout": 10000,
      "failure_policy": "warn"
    }
  ],
  "lifecycle_hooks": {
    "on_session_start": [
      {
        "name": "session_init",
        "script": "core/hooks/session-start-init.sh",
        "enabled": true
      }
    ],
    "on_session_end": [
      {
        "name": "session_cleanup",
        "script": "core/hooks/session-end-cleanup.sh",
        "enabled": true
      }
    ],
    "on_file_save": [
      {
        "name": "code_quality_check",
        "script": "core/hooks/file-save-quality-check.sh",
        "enabled": true
      }
    ],
    "after_command_execution": [
      {
        "name": "learning_update",
        "script": "core/hooks/command-exec-learning.sh",
        "enabled": true
      }
    ]
  },
  "hook_configuration": {
    "max_concurrent_hooks": 3,
    "global_timeout": 30000,
    "retry_failed_hooks": true,
    "max_hook_retries": 2,
    "hook_execution_order": "priority_based",
    "failure_isolation": true
  }
}