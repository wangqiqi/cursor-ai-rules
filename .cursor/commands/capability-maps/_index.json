{
  "version": "2.0.0",
  "structure": "modular",
  "description": "🎯 模块化能力映射表 - 主索引文件",
  "compatibility": ">=1.0.0",
  "last_updated": "2026-01-23T19:00:00Z",
  "author": "wangqiqi",
  "total_mappings": 33,

  "structure_definition": {
    "global": "全局配置和元数据",
    "mappings": "能力映射，按功能类别分组",
    "advanced": "高级配置选项"
  },

  "includes": [
    "global/config.json",
    "global/metadata.json",
    "mappings/project.json",
    "mappings/code.json",
    "mappings/deployment.json",
    "mappings/testing.json",
    "mappings/learning.json",
    "mappings/system.json",
    "mappings/hooks-execution.json",
    "mappings/skills-execution.json",
    "mappings/role-system.json",
    "advanced/intent-patterns.json",
    "advanced/execution-presets.json",
    "advanced/error-handling.json",
    "advanced/loop-while-automation.json",
    "advanced/performance-optimization.json",
    "advanced/version-info.json",
    "advanced/hooks-management.json",
    "advanced/skills-loading.json"
  ],

  "load_order": [
    "global",
    "mappings",
    "advanced"
  ],

  "fallback": {
    "enabled": true,
    "legacy_file": "../capability-map.json",
    "description": "如果模块化加载失败，回退到传统单文件结构"
  },

  "validation": {
    "schema_file": "../../config/capability-map.schema.json",
    "strict_mode": false,
    "allow_missing_files": true
  },

  "caching": {
    "enabled": true,
    "ttl_seconds": 3600,
    "invalidate_on_change": true
  }
}