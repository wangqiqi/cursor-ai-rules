        "commit-message-generation",
        "push-to-remote"
      ],
      "hooks": [
        "pre-commit.sh",
        "commit-msg.sh"
      ]
    },
    "execution_order": [
      "rules",
      "scripts",
      "workflows",
      "skills",
      "hooks"
    ],
    "parameters": {
      "generate_message": true,
      "run_checks": true,
      "auto_push": false,
      "conventional_commits": true
    },
    "validation_rules": {
