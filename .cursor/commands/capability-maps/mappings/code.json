    "execution_order": [
      "scripts",
      "workflows",
      "skills"
    ],
    "parameters": {
      "formatter": "prettier",
      "file_extensions": [".js", ".ts", ".jsx", ".tsx", ".json", ".md"],
      "write_changes": true,
      "check_only": false
    },
    "validation_rules": {
      "max_line_length": 120,
      "indent_style": "spaces",
      "indent_size": 2
    }
