  "execution_presets": {
    "fast_mode": {
      "description": "快速执行模式，跳过非必要步骤",
      "timeout_multiplier": 0.7,
      "skip_optional_steps": true,
      "parallel_execution": true
    },
    "thorough_mode": {
      "description": "全面执行模式，包含所有验证步骤",
      "timeout_multiplier": 1.5,
      "skip_optional_steps": false,
      "parallel_execution": false,
      "additional_validations": true
    },
    "safe_mode": {
      "description": "安全执行模式，包含回滚和备份",
      "timeout_multiplier": 2.0,
      "rollback_enabled": true,
      "backup_before_execution": true,
      "progress_confirmations": true
    }
  },
  "error_handling": {
    "strategies": {
      "retry_on_failure": {
        "max_attempts": 3,
        "backoff_multiplier": 2,
        "retryable_errors": [
          "timeout",
          "network",
          "resource_locked"
        ]
      },
      "fallback_execution": {
        "enabled": true,
        "fallback_mappings": {
          "check_code_quality": [
            "basic_lint"
          ],
          "run_tests": [
            "smoke_tests"
          ],
          "deploy_application": [
            "staging_deploy"
          ]
        }
      },
      "graceful_degradation": {
        "enabled": true,
        "degradation_levels": [
          "full",
          "partial",
          "minimal",
          "disabled"
        ]
      }
    },
    "recovery_actions": {
      "rollback_changes": {
        "git_reset": true,
        "file_backup_restore": true,
        "config_rollback": true
      },
      "cleanup_resources": {
        "temp_files": true,
        "cache_clear": true,
        "process_kill": true
      },
      "notification_sending": {
        "user_notification": true,
        "error_logging": true,
        "metric_reporting": true
      }
    }
  },
