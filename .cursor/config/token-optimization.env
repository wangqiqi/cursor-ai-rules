# 🎯 Cursor AI Rules - Token优化配置
# 实测见 .cursor/docs/reference/TOKEN_COMPRESSION_BENCHMARK.md

# 压缩级别: minimal（默认）| balanced（同 minimal）| aggressive（仅 JSON）| maximum（已降级）
export COMPRESSION_LEVEL="minimal"
export STREAMING_ENABLED="true"
export INCREMENTAL_UPDATES="true"

# Markdown/文本：空白、徽章行、emoji、重复 ---（推荐开启）
export TOKEN_COMPRESS_MARKDOWN="true"
# JSON 键名缩写：默认关闭（对 CHANGELOG/README 无益）
export TOKEN_COMPRESS_JSON_KEYS="false"
# 语义缩写（仅 aggressive + JSON 时可选）
export TOKEN_COMPRESS_SEMANTIC="false"

# 输出控制
export COMPACT_MODE="true"
export USE_COLORS="false"

# 缓存配置
export MAX_CACHE_ENTRIES="1000"
export CACHE_TTL_HOURS="24"
export COMPRESSION_RATIO_TARGET="30"

# 性能监控
export PERFORMANCE_MONITORING="true"
export TOKEN_WARNING_THRESHOLD="800"
export RESPONSE_TIME_WARNING="2000"

# 上下文管理
export CONTEXT_CACHE_ENABLED="true"
export CONTEXT_TTL_MINUTES="30"
export MAX_CONTEXT_SIZE="5000"
