{
  "version": 1,
  "description": "Cursor AI Rules — plugin hooks (synced from .cursor/hooks.json)",
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/role-activation.sh",
        "timeout": 8,
        "failClosed": false
      },
      {
        "command": "./hooks/master-init.sh",
        "timeout": 7,
        "failClosed": false
      },
      {
        "command": "./hooks/env-perception.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./hooks/session-optimizer.sh",
        "timeout": 6,
        "failClosed": false
      },
      {
        "command": "./scripts/growth_init.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./hooks/session-state-guard.sh",
        "timeout": 2,
        "failClosed": false
      },
      {
        "command": "./hooks/conversation-init.sh",
        "timeout": 3,
        "failClosed": false
      },
      {
        "command": "./hooks/master-sync-init.sh",
        "timeout": 2,
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/cursor-sync.sh",
        "timeout": 10,
        "failClosed": false
      },
      {
        "command": "./core/continuous-learning-loop.sh",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "./hooks/consistency-check.sh",
        "timeout": 10,
        "failClosed": false
      },
      {
        "command": "./hooks/architecture-check.sh",
        "timeout": 8,
        "failClosed": false
      },
      {
        "command": "./hooks/code-quality.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./hooks/quality-check.sh",
        "timeout": 15,
        "failClosed": false
      },
      {
        "command": "./core/config-manager.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./hooks/dependency-check.sh",
        "timeout": 8,
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": "./hooks/performance-monitor.sh",
        "timeout": 3,
        "failClosed": false
      },
      {
        "command": "./hooks/logging-common.sh",
        "timeout": 3,
        "failClosed": false
      }
    ],
    "afterAgentResponse": [
      {
        "command": "./hooks/growth-recorder.sh",
        "timeout": 3,
        "failClosed": false
      },
      {
        "command": "./hooks/token-compression.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./core/agent-orchestration-engine.sh",
        "timeout": 15,
        "failClosed": false
      },
      {
        "command": "./core/context-pool-manager.sh",
        "timeout": 8,
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/session-state-guard.sh",
        "timeout": 4,
        "failClosed": false
      },
      {
        "command": "./hooks/role-sync.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./core/context-manager.sh",
        "timeout": 5,
        "failClosed": false
      },
      {
        "command": "./hooks/prompt-security.sh",
        "timeout": 2,
        "failClosed": true
      },
      {
        "command": "./hooks/master-sync-trigger.sh",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
