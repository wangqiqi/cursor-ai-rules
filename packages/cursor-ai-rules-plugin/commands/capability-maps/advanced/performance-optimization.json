{
  "caching": {
    "capability_maps": {
      "enabled": true,
      "ttl": 3600,
      "invalidation_events": [
        "file_change",
        "config_update",
        "manual_invalidate"
      ]
    },
    "execution_results": {
      "enabled": true,
      "ttl": 1800,
      "max_entries": 1000
    }
  },
  "parallelization": {
    "max_concurrent_executions": 5,
    "resource_pooling": true,
    "load_balancing": true
  },
  "lazy_loading": {
    "mappings": true,
    "skills": true,
    "scripts": false,
    "rules": true
  },
  "system_health_monitoring": {
    "enabled": true,
    "alerts": {
      "high_memory_usage": "85%",
      "high_cpu_usage": "80%",
      "response_time_degradation": "2000ms",
      "error_rate_threshold": "5%"
    }
  },
  "user_behavior_analysis": {
    "enabled": true,
    "track_patterns": [
      "frequent_commands",
      "error_patterns",
      "performance_trends"
    ],
    "privacy_compliant": true
  },
  "monitoring_and_analytics": {
    "description": "系统监控和分析配置",
    "execution_tracking": {
      "enabled": true,
      "metrics": [
        "execution_time",
        "success_rate",
        "resource_usage",
        "error_types"
      ],
      "retention_days": 30
    },
    "user_behavior_analysis": {
      "enabled": true,
      "track_patterns": [
        "command_frequency",
        "error_recovery",
        "feature_adoption"
      ],
      "privacy_compliant": true
    },
    "system_health_monitoring": {
      "enabled": true,
      "alerts": {
        "memory_threshold": "85%",
        "cpu_threshold": "80%",
        "disk_threshold": "90%"
      }
    }
  }
}