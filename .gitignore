# Cursor AI 生长数据 - 自动感知和学习
# 这些数据包含用户偏好、本地配置和学习数据，不应在仓库中跟踪
.cursorGrowth/

# Cursor 系统文件
.cursor/web/node_modules/
.cursor/web/package-lock.json
.cursor/web/server.pid
.cursor/web/server.log
.cursor/**/*.log
.cursor/**/*.pid
# Hook 运行时监控目录（由 logging-common.sh 自动创建）
.cursor/monitoring/

archive/

# Legacy dual-tree plugin output (removed — use .cursor-plugin/ + .cursor/ only)
packages/


# 项目角色配置（每个用户独立）
# 已迁移至 .cursorGrowth/user/config/project_state.json
.cursor-project.json

# 旧版 Web 文件路径 (向后兼容)
web/node_modules/
web/package-lock.json
web/server.pid
web/server.log
server.pid

# Node.js 依赖
node_modules/
package-lock.json

# 日志文件
*.log
*.pid

# 操作系统文件
.DS_Store
Thumbs.db

# IDE 和编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件
.tmp/
temp/
*.tmp

