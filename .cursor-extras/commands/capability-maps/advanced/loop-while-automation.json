    "loop_while_phases": {
      "clarification": {
        "description": "🎯 需求澄清阶段",
        "duration": "2-4 hours",
        "success_criteria": "用户确认需求完整性",
        "failure_handling": "暂停等待澄清",
        "next_phase": "developing"
      },

      "developing": {
        "description": "🔧 代码开发阶段",
        "duration": "4-8 hours",
        "success_criteria": "代码编译通过",
        "failure_handling": "记录错误，继续迭代",
        "next_phase": "testing"
      },

      "testing": {
        "description": "🧪 测试验证阶段",
        "duration": "2-4 hours",
        "success_criteria": "测试覆盖率>80%，所有测试通过",
        "failure_handling": "修复测试失败，重新测试",
        "next_phase": "documenting"
      },

      "documenting": {
        "description": "📚 文档完善阶段",
        "duration": "1-2 hours",
        "success_criteria": "API文档完整，README更新",
        "failure_handling": "补充缺失文档",
        "next_phase": "reviewing"
      },

      "reviewing": {
        "description": "🔍 最终审查阶段",
        "duration": "1-2 hours",
        "success_criteria": "质量评分>95%",
        "failure_handling": "质量不足，继续循环",
        "next_phase": "completed|developing"
      }
    },

    "quality_metrics": {
      "compilation_success": {
        "weight": 0.15,
        "description": "代码编译检查",
        "threshold": 1.0,
        "measurement": "boolean"
      },

      "test_coverage": {
        "weight": 0.25,
        "description": "测试覆盖率",
        "threshold": 0.8,
        "measurement": "percentage"
      },

      "code_quality": {
        "weight": 0.15,
        "description": "代码质量评分",
        "threshold": 0.85,
        "measurement": "score"
      },

      "security_score": {
        "weight": 0.20,
        "description": "安全检查评分",
        "threshold": 0.9,
        "measurement": "score"
      },

      "documentation_completeness": {
        "weight": 0.10,
        "description": "文档完整性",
        "threshold": 0.95,
        "measurement": "score"
      },

      "performance_score": {
        "weight": 0.15,
        "description": "性能指标",
        "threshold": 0.85,
        "measurement": "score"
      }
    },

    "rate_limiting_config": {
      "providers": {
        "openai": {
          "rpm": 200,
          "tpm": 40000,
          "rpd": 10000,
          "retry_strategy": "exponential_backoff",
          "circuit_breaker": true
        },
        "anthropic": {
          "rpm": 50,
          "tpm": 100000,
          "rpd": 1000,
          "retry_strategy": "linear_backoff",
          "circuit_breaker": true
        },
        "google": {
          "rpm": 60,
          "tpm": 1000000,
          "rpd": 1500,
          "retry_strategy": "immediate_retry",
          "circuit_breaker": false
        }
      },

      "adaptive_control": {
        "enabled": true,
        "performance_window": 3600,
        "adjustment_interval": 300,
        "max_increase": 2.0,
        "min_decrease": 0.1
      }
    },

    "context_management": {
      "persistence_strategy": "hybrid",
      "compression_enabled": true,
      "max_context_age": 2592000,
      "cross_session_continuity": true,
      "conflict_resolution": "latest_wins",

      "storage_structure": {
        "sessions": "存储对话会话",
        "versions": "版本历史管理",
        "cache": "临时缓存数据",
        "snapshots": "完整状态快照"
      }
    },

    "monitoring_and_alerts": {
      "real_time_metrics": {
        "loop_progress": true,
        "quality_trends": true,
        "resource_usage": true,
        "error_rates": true
      },

      "alerts": {
        "quality_threshold_breach": {
          "enabled": true,
          "threshold": 0.9,
          "action": "notify_user"
        },
        "rate_limit_exceeded": {
          "enabled": true,
          "threshold": "95%",
          "action": "auto_throttle"
        },
        "context_overflow": {
          "enabled": true,
          "threshold": "85%",
          "action": "auto_compress"
        },
        "iteration_limit_reached": {
          "enabled": true,
          "threshold": 45,
          "action": "force_completion"
        }
      },

      "dashboards": {
        "loop_progress": {
          "enabled": true,
          "update_interval": 30,
          "metrics": ["iteration_count", "quality_score", "completion_percentage"]
        },
        "resource_monitoring": {
          "enabled": true,
          "update_interval": 60,
          "metrics": ["cpu_usage", "memory_usage", "api_calls", "token_usage"]
        },
        "quality_analytics": {
          "enabled": true,
          "update_interval": 300,
          "metrics": ["compilation_rate", "test_pass_rate", "linting_score", "security_score"]
        }
      }
    },

    "advanced_features": {
      "parallel_processing": {
        "enabled": true,
        "max_concurrent_tasks": 3,
        "load_balancing": "intelligent",
        "resource_awareness": true
      },

      "learning_and_adaptation": {
        "performance_learning": true,
        "pattern_recognition": true,
        "adaptive_optimization": true,
        "user_preference_learning": true
      },

      "enterprise_integration": {
        "role_based_access": false,
        "audit_logging": true,
        "compliance_checking": false,
        "enterprise_monitoring": false
      }
