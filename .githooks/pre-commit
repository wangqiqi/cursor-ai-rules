#!/usr/bin/env bash
# Verify single-repo plugin manifest when .cursor/ or plugin.json changes.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED="$(git diff --cached --name-only)"
if ! echo "$STAGED" | grep -qE '^\.cursor/|^\.cursor-plugin/'; then
  exit 0
fi

echo "🔍 .cursor/ or .cursor-plugin/ changed — verifying plugin manifest ..."
bash scripts/bump-plugin-version.sh 2>/dev/null || true
git add .cursor-plugin/plugin.json 2>/dev/null || true
bash scripts/verify-plugin-manifest.sh
